# Copy this file to .env and fill in your values
# cp .env.example .env

# Database connection string
DATABASE_URL=postgresql://user:password@db:5432/youknowit

# Secret key for signing JWT tokens
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# App settings
APP_NAME=You Know It
DEBUG=false
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Postgres credentials for local development
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=